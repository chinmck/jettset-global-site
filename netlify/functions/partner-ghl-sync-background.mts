export default async (request:Request)=>{if(request.method!=="POST")return new Response("Method not allowed",{status:405});const endpoint=process.env.GHL_PARTNER_HUB_WEBHOOK_URL;if(!endpoint||endpoint.includes("preview-pending"))return new Response(null,{status:202});const payload=await request.json();try{const response=await fetch(endpoint,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(payload),signal:AbortSignal.timeout(15000)});if(!response.ok)throw new Error("CRM webhook rejected request");return new Response(null,{status:202})}catch{return new Response(null,{status:502})}}
export const config={type:"background"};
